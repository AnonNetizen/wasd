{
  "dirs": [
    "res://tests/unit",
    "res://tests/integration"
  ],
  "include_subdirs": true,
  "prefix": "test_",
  "suffix": ".gd",
  "should_exit": true,
  "should_exit_on_success": true,
  "failure_error_types": [
    "engine",
    "gut",
    "push_error"
  ],
  "hide_orphans": false,
  "junit_xml_timestamp": false,
  "log_level": 1
}
