{
	"schema_version": 3,
	"asset_id": "<stable_asset_id>",
	"source_image": "res://assets/polygon_art/<source_image>.png",
	"style_profile": "res://data/polygon_art_style.json",
	"output_asset": "res://data/polygon_assets/<asset_id>.polygon.json",
	"prompt_template": "res://data/polygon_prompt_templates/source_image_v1.json",
	"background_key": "#ff00ff",
	"pivot": {
		"mode": "foreground_bounds_center"
	},
	"default_region": "<primary_region>",
	"palette": {
		"outline": "<outline_color>",
		"surface_light": "<primary_light>",
		"surface_mid": "<primary_mid>",
		"surface_shadow": "<primary_shadow>",
		"secondary_light": "<secondary_light>",
		"secondary_shadow": "<secondary_shadow>",
		"accent_warm": "<accent_color>"
	},
	"palette_surface_kinds": {
		"surface_light": "<primary_surface_kind>",
		"surface_mid": "<primary_surface_kind>",
		"surface_shadow": "<primary_surface_kind>",
		"secondary_light": "<secondary_surface_kind>",
		"secondary_shadow": "<secondary_surface_kind>",
		"accent_warm": "<primary_surface_kind>"
	},
	"motion_profile": {
		"motion_axis": [
			1.0,
			0.0
		],
		"primary_motion_regions": [],
		"secondary_motion_regions": [],
		"motion_surface_kinds": [],
		"generation_tint_palette_role": "accent_warm",
		"dissolve_tint_palette_role": "secondary_shadow"
	},
	"custom_animation": {},
	"feature_guides": [],
	"prompt_variables": {
		"asset_type": "<gameplay_asset_type>",
		"subject": "<single_subject_name>",
		"view": "<exact_orthographic_view>",
		"gameplay_read": "<how_the_connected_silhouette_explains_the_object>",
		"silhouette": "<recognizable_outer_contour_without_texture>",
		"proportions": "<aspect_ratio_symmetry_and_canvas_occupancy>",
		"palette": "<four_to_seven_discrete_color_roles>",
		"forbidden_details": "<asset_specific_exclusions>"
	},
	"facet_emphasis": [],
	"anchors": {
		"center": [
			0.5,
			0.5
		],
		"interaction": [
			0.5,
			0.5
		]
	},
	"collision": {
		"strategy": "convex_hull",
		"static_during_visual_animation": true
	},
	"generation": {
		"tool": "builtin_imagegen",
		"mode": "generate",
		"prompt_template": "res://data/polygon_prompt_templates/source_image_v1.json",
		"postprocess": [
			"godot_chroma_normalize_to_exact_ff00ff"
		]
	}
}
